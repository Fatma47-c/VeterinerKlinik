@model VeterinerKlinik.Models.Muayene

@{
    ViewData["Title"] = "Muayene Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4>🗑️ Muayene Sil</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        Bu muayene kaydını silmek istediğinize emin misiniz?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Hayvan Adı</dt>
                        <dd class="col-sm-8">@Model.HayvanAdi</dd>

                        <dt class="col-sm-4">Müşteri Adı</dt>
                        <dd class="col-sm-8">@Model.MusteriAdi</dd>

                        <dt class="col-sm-4">Veteriner</dt>
                        <dd class="col-sm-8">@Model.Veteriner?.Ad</dd>

                        <dt class="col-sm-4">Tarih</dt>
                        <dd class="col-sm-8">
                            @Model.Tarih.ToString("dd.MM.yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-4">Teşhis</dt>
                        <dd class="col-sm-8">@Model.Teshis</dd>

                        <dt class="col-sm-4">Tedavi</dt>
                        <dd class="col-sm-8">@Model.Tedavi</dd>

                        <dt class="col-sm-4">Ücret</dt>
                        <dd class="col-sm-8">@Model.Ucret.ToString("C2")</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-danger">
                                Evet, Sil
                            </button>
                            <a asp-action="Index"
                               class="btn btn-secondary">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
