@model IEnumerable<VeterinerKlinik.Models.Muayene>

@{
    ViewData["Title"] = "Muayene Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🏥 Muayene Listesi</h2>
        <a asp-action="Create" class="btn btn-primary">+ Yeni Muayene</a>
    </div>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Tarih</th>
                    <th>Hayvan Adı</th>
                    <th>Müşteri</th>
                    <th>Veteriner</th>
                    <th>Teşhis</th>
                    <th>Tedavi</th>
                    <th>Ücret</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@m.HayvanAdi</td>
                        <td>@m.MusteriAdi</td>
                        <td>@m.Veteriner?.Ad @m.Veteriner?.Soyad</td>
                        <td>@m.Teshis</td>
                        <td>@m.Tedavi</td>
                        <td>@m.Ucret.ToString("C2")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@m.Id"
                               class="btn btn-sm btn-info">Detay</a>
                            <a asp-action="Edit" asp-route-id="@m.Id"
                               class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@m.Id"
                               class="btn btn-sm btn-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Henüz muayene kaydı bulunmamaktadır.
        </div>
    }
</div>